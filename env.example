# ============================================================
# INFORMASI APLIKASI
# ============================================================

# Nama aplikasi.
#
# Nilai ini dapat digunakan oleh aplikasi untuk menampilkan
# nama project pada bagian tertentu jika diperlukan.
APP_NAME=Electronic Store


# Versi aplikasi.
#
# Nilai ini mengikuti versi yang ada pada pubspec.yaml.
#
# pubspec.yaml:
# version: 1.0.0+1
#
# APP_VERSION hanya menyimpan versi utama aplikasi.
APP_VERSION=1.0.0


# Environment aplikasi.
#
# development = aplikasi sedang dalam tahap pengembangan/testing.
#
# Environment lain yang umum digunakan:
#
# development
# staging
# production
#
APP_ENV=development


# ============================================================
# SUPABASE
# ============================================================

# URL project Supabase.
#
# URL ini digunakan Flutter untuk mengetahui project Supabase
# mana yang akan digunakan sebagai backend.
#
# Format:
#
# https://<project-id>.supabase.co
#
SUPABASE_URL="https://PROJECT-ID.supabase.co"


# Publishable key Supabase.
#
# Key ini digunakan oleh aplikasi Flutter untuk berkomunikasi
# dengan Supabase dari sisi client.
#
# PENTING:
#
# Jangan memasukkan service_role key atau secret key ke dalam
# aplikasi Flutter.
#
# Keamanan database tetap harus menggunakan:
#
# - Row Level Security (RLS)
# - Supabase Policies
# - Authentication
#
SUPABASE_PUBLISHABLE_KEY="YOUR_SUPABASE_PUBLISHABLE_KEY"